{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Glob",
      "Grep",
      "Task",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go generate:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(just:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/secrets/**)",
      "Read(**/.resim/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(gt:*)",
      "Bash(git reset --hard:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl exec:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(docker push:*)",
      "Bash(docker buildx bake --push:*)",
      "Bash(npm publish:*)",
      "Bash(packer build:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "env": {
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1"
  },
  "extraKnownMarketplaces": {
    "resim-tools": {
      "source": {
        "source": "github",
        "repo": "resim-ai/workspace"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "resim-shared@resim-tools": true,
    "signal-flag@resim-tools": true
  }
}
